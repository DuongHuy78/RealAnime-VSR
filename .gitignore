# =============================================================================
# Gitignore for RealAnime-VSR
# =============================================================================

# --- Byte-compiled / optimized / DLL files ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Virtual Environments ---
.venv/
.venv*/
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Packaging / Distribution ---
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# --- Node.js / Frontend ---
frontend/node_modules/
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Environment Variables & Sensitive Credentials ---
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
# Giữ lại các file mẫu cấu hình
!.env.example
!backend/.env.example
!frontend/.env.example

# Private Keys & Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_ed25519
secrets/
credentials.json
token.json

# --- AI Model Checkpoints & Large Weights ---
*.pth
*.pt
*.ckpt
*.bin
*.safetensors
*.onnx
*.engine
*.h5
*.hdf5
*.pb
*.tflite
*.pkl
*.pickle
best.pth
models/*
!models/.gitkeep
checkpoints/
weights/

# --- Dynamic Uploads, Outputs & Temporary Work Folders ---
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep
work/*
!work/.gitkeep
tmp/
temp/
*.tmp

# --- Jupyter Notebook Caches ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Logs & Test Artifacts ---
*.log
logs/
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# --- IDEs, Editors & OS Files ---
.vscode/
.idea/
*.swp
*.swo
*~
.agents/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
