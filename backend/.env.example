# Directory paths (relative to backend/ or absolute)
UPLOADS_DIR=../uploads
OUTPUTS_DIR=../outputs
MODELS_DIR=../models
CHECKPOINT_PATH=../best.pth

# Image limits
MAX_UPLOAD_SIZE_MB=15
MAX_IMAGE_DIMENSION=512
MAX_IMAGE_PIXELS=102400
MIN_IMAGE_DIMENSION=16
CLEANUP_INTERVAL_MINUTES=60
CLEANUP_MAX_AGE_HOURS=24
# Hardware acceleration settings (auto | cuda | cpu)
AI_DEVICE=auto
CUDA_DEVICE_INDEX=0
MAX_IMAGE_PIXELS_GPU=102400

# CORS settings for development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8080"]
